{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Headmaster",
  "description": "Licence and Cloud control panel services for Headmaster-managed runtimes.",
  "seo": {
    "metatags": {
      "keywords": "Headmaster, licence panel, Cloud control panel, managed runtimes"
    }
  },
  "theme": "mint",
  "logo": {
    "light": "/logo/headmaster.svg",
    "dark": "/logo/headmaster.svg"
  },
  "colors": {
    "primary": "#1A4D2E",
    "light": "#F7F7F5",
    "dark": "#1A4D2E"
  },
  "favicon": "/logo/headmaster.svg",
  "redirects": [
    { "source": "/api", "destination": "/headmaster-compatibility" },
    { "source": "/api/:slug*", "destination": "/headmaster-compatibility" },
    { "source": "/compare", "destination": "/introduction" },
    { "source": "/concepts", "destination": "/introduction" },
    { "source": "/concepts/:slug*", "destination": "/introduction" },
    { "source": "/configuration", "destination": "/introduction" },
    { "source": "/configuration/:slug*", "destination": "/introduction" },
    { "source": "/guides", "destination": "/introduction" },
    { "source": "/guides/:slug*", "destination": "/introduction" },
    { "source": "/headmaster-build-manifest.json", "destination": "/headmaster-compatibility" },
    { "source": "/support", "destination": "/quickstart" },
    { "source": "/support/:slug*", "destination": "/quickstart" }
  ],
  "navbar": {
    "primary": {
      "type": "github",
      "href": "https://github.com/mutvayzz-sys/Gcaplabs-LPanel"
    }
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": ["introduction", "quickstart"]
      },
      {
        "group": "Cloud control panel",
        "pages": [
          "headmaster-cloud-inference",
          "headmaster-integration"
        ]
      },
      {
        "group": "Contributor reference",
        "pages": [
          "headmaster-managed-config",
          "headmaster-compatibility",
          "self-hosting"
        ]
      }
    ]
  }
}
